generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  twoFactorEnabled  Boolean  @default(false)
  twoFactorSecret   String?
  createdAt DateTime @default(now())
}